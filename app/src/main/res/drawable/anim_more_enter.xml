<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="dot1"
                android:pivotX="6"
                android:pivotY="12">
                <path
                    android:fillColor="#FF000000"
                    android:pathData="M 6 10 c -1.1 0 -2 0.9 -2 2 s 0.9 2 2 2 s 2 -0.9 2 -2 s -0.9 -2 -2 -2 Z" />
            </group>
            <group
                android:name="dot2"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:fillColor="#FF000000"
                    android:pathData="M 12 10 c -1.1 0 -2 0.9 -2 2 s 0.9 2 2 2 s 2 -0.9 2 -2 s -0.9 -2 -2 -2 Z" />
            </group>
            <group
                android:name="dot3"
                android:pivotX="18"
                android:pivotY="12">
                <path
                    android:fillColor="#FF000000"
                    android:pathData="M 18 10 c -1.1 0 -2 0.9 -2 2 s 0.9 2 2 2 s 2 -0.9 2 -2 s -0.9 -2 -2 -2 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="dot1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="70"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="70"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="140"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="140"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
